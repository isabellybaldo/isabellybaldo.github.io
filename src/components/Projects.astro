---
import { projects } from '../data/projects.ts';
---
<section id="projects">
  <h2>stuff i made</h2>
  <div class="grid">
    {projects.map((p) => (
      <article class={`project pixel-card accent-${p.accent}${p.comingSoon ? ' coming-soon' : ''}`}>
        <div class="project__thumb">
          <img src={p.thumb} alt={`${p.title} pixel art`} class="pixelated" width="96" height="96" />
          {p.comingSoon && <span class="badge">coming soon</span>}
        </div>
        <h3>{p.title}</h3>
        <p class="project__tracks">{p.tracks}</p>
        <p class="muted">{p.blurb}</p>
        <div class="project__tags">
          {p.tech.map((t) => <span class="tag">{t}</span>)}
        </div>
        {!p.comingSoon && p.href && (
          <p><a class="pixel-btn pixel-btn--pink" href={p.href} rel="noopener noreferrer">view</a></p>
        )}
      </article>
    ))}
  </div>
</section>
